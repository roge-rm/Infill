// The launcher's icon and the details Windows shows in its Properties.
// Filled in by CMake (configure_file in desktop/native/CMakeLists.txt).
#include <winver.h>

1 ICON "@LAUNCHER_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Dan Hunke"
            VALUE "FileDescription", "Infill"
            VALUE "ProductName", "Infill"
            VALUE "ProductVersion", "@INFILL_VERSION@"
            VALUE "FileVersion", "@INFILL_VERSION@"
            VALUE "LegalCopyright", "Copyright (C) 2026 Dan Hunke. GPLv3 or later."
            VALUE "OriginalFilename", "Infill.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
